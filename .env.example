# Copy to .env and adjust per environment.
APP_NAME=Career Platform
APP_ENV=development
# Local Docker Postgres (see README). On EC2 it is the career_app role on RDS,
# over verified TLS, in a mode-600 .env that never leaves the server:
#   postgresql://career_app:<PASSWORD>@<RDS_ENDPOINT>:5432/career?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
DATABASE_URL=postgresql://postgres:test@localhost:54329/career_dev
